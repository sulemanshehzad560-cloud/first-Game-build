{
  "appId": "com.sulemanshehzad.jaderush",
  "appName": "Jade Rush",
  "webDir": "www",
  "android": {
    "backgroundColor": "#0b2621",
    "allowMixedContent": false,
    "captureInput": true,
    "minWebViewVersion": 84
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DARK"
    },
    "StatusBar": {
      "style": "DARK",
      "overlaysWebView": true,
      "backgroundColor": "#00000000"
    }
  },
  "server": {
    "errorPath": "webview-update.html"
  },
  "ios": {
    "backgroundColor": "#0b2621",
    "contentInset": "never",
    "scrollEnabled": false,
    "includePlugins": [
      "@capacitor-community/admob",
      "@capacitor/app",
      "@capacitor/haptics",
      "@capacitor/status-bar"
    ]
  }
}
